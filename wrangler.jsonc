// Cloudflare deployment: a Worker in front of one container running the app (the Dockerfile).
// Deployed by .github/workflows/deploy.yml. Secrets are never kept here: they come from GitHub
// Secrets at deploy time (see DEPLOY.md). Data lives in Supabase Postgres (DATABASE_URL).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xc-training",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "XcApp",
      "image": "./Dockerfile",
      // One instance: the app keeps sign-in limits and the nightly-job lock in memory.
      "max_instances": 1,
      // 1/4 vCPU, 1 GiB memory. Raise to "standard-1" if pages feel slow.
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "XC_APP", "class_name": "XcApp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["XcApp"] }],
  "triggers": {
    // UTC. The app runs the nightly job only when it is NIGHTLY_HOUR in TEAM_TIMEZONE, so call at
    // both daylight-saving offsets: 11:00 and 12:00 UTC are 4 a.m. Pacific in summer and winter.
    // Change these if you change NIGHTLY_HOUR or TEAM_TIMEZONE.
    // 4 a.m. Pacific (nightly job) and 5 p.m. Pacific (reminder emails), at both daylight-saving offsets.
    "crons": ["0 11 * * *", "0 12 * * *", "0 0 * * *", "0 1 * * *"]
  },
  // Settings that are not secret. Secrets (DATABASE_URL, SECRET_KEY, ...) are listed in cloudflare/worker.js.
  "vars": {
    // The app's public https address, used in athlete links and for Garmin (no trailing slash).
    "BASE_URL": "https://xc-training.jesuit-xc.workers.dev",
    "TEAM_TIMEZONE": "America/Los_Angeles",
    "TEAM_NAME": "Jesuit Cross Country",
    "NIGHTLY_HOUR": "4",
    // Daily reminder emails to athletes who opted in (team time, 24-hour clock). EMAIL_FROM must use a domain verified with Resend.
    "REMINDER_HOUR": "17",
    "EMAIL_FROM": "",
    // Days of past runs requested from Garmin when an athlete connects (also stated in the privacy policy).
    "GARMIN_BACKFILL_DAYS": "90",
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    // AI spending cap in US dollars per month (also set a spend limit in the Claude Console), and thinking level.
    "AI_MONTHLY_BUDGET_USD": "25",
    "AI_EFFORT": "medium",
    // Shown in the public privacy policy at /privacy.
    "ORG_NAME": "Jesuit High School",
    "PRIVACY_CONTACT": "keegan.smith@jesuithighschool.org",
    "HOSTING_PROVIDER": "Cloudflare, Inc. (runs the app) and Supabase, Inc. (stores the database)",
    "CERTIFICATE_PROVIDER": "Cloudflare",
    "PRIVACY_EFFECTIVE_DATE": "November 1, 2026",
    "DATA_RETENTION_DAYS": "90"
  }
}

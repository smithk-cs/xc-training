# Public web address of this app (must be https for Garmin). Also used in athlete links.
BASE_URL=https://xc.yourschool.org
DOMAIN=xc.yourschool.org
TEAM_TIMEZONE=America/Los_Angeles

# Shown on every page. Upload the approved logo on the Staff page (kept in the database). Or, on a Docker server,
# put the file (png, jpg, svg or webp) in the data volume, e.g. /data/team-logo.png, and name it here.
TEAM_NAME=Jesuit Cross Country
TEAM_LOGO_FILE=

# Generate these four with: python -m xcapp.cli gen-keys   (keep them secret; never change TOKEN_KEY)
SECRET_KEY=
TOKEN_KEY=
GARMIN_WEBHOOK_SECRET=
# Lets the hosting platform's nightly timer call POST /cron/nightly. Not needed with docker compose (it has a scheduler).
CRON_SECRET=

# From the Garmin Developer Portal once your Connect Developer Program app is approved.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# From the Claude Console (platform.claude.com). Leave blank to turn the AI briefing off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Hour (0-23, team time zone) for the nightly token refresh and AI briefing.
NIGHTLY_HOUR=4

# Leave these alone in production.
SECURE_COOKIES=true
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
# AS_OF_DATE=2026-10-25   # demo only: pins "today" so the sample season looks current
